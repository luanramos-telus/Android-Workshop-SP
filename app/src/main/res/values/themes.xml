<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base XML theme for the Activity window. All UI is rendered by Compose;
         this only sets the window chrome before Compose takes over. -->
    <style name="Theme.PontoMais" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
