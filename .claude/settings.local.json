{
  "permissions": {
    "allow": [
      "WebFetch(domain:api.anthropic.com)",
      "Bash(grep -v \"^[[:space:]]*$\")"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./**/local.properties)",
      "Edit(./local.properties)",
      "Edit(./**/local.properties)",
      "Write(./local.properties)",
      "Write(./**/local.properties)",

      "Read(./**/keystore.properties)",
      "Edit(./**/keystore.properties)",
      "Write(./**/keystore.properties)",

      "Read(./**/secrets.properties)",
      "Edit(./**/secrets.properties)",
      "Write(./**/secrets.properties)",

      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",

      "Read(./**/google-services.json)",
      "Read(./**/GoogleService-Info.plist)",

      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",

      "Bash(cat *local.properties*)",
      "Bash(cat *keystore.properties*)",
      "Bash(cat *secrets.properties*)",
      "Bash(cat *.env*)",
      "Bash(cat *.keystore)",
      "Bash(cat *.jks)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *google-services.json*)"
    ]
  }
}
